# GEMINI_API_KEY: Required for Gemini & Google Veo 3 AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# VEO3_API_KEY: Optional dedicated API key for Google Veo 3 video generation engine.
VEO3_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# VITE_API_BASE_URL: Backend API base URL for mobile client (Capacitor iOS/Android).
# Set to your deployed Cloud Run backend URL.
VITE_API_BASE_URL=https://ais-pre-ydudbuq6rbqytdazbc24df-542290042380.europe-west1.run.app

